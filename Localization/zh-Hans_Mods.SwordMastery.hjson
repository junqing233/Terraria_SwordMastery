			清除玩家所有负面buff
			给予玩家大幅度增益buff
			'''
	}

	AllCreationFalls: {
		DisplayName: 十方俱灭
		Tooltip:
			'''
			缓慢的发射十道激光摧毁敌人
			右键可放置，放置后点击神兵发射激光
			'''
	}

	PhoenixEmperorAxe: {
		DisplayName: 凤皇
		Tooltip: 攻击可击退敌人并造成霜冻效果
	}

	RavageCrab: {
		DisplayName: 惊邪
		Tooltip: 获得破甲效果
	}

	HeavenlyPunishment: {
		DisplayName: 天诛
		Tooltip: 一次射出9支箭
	}

	TigerVigor: {
		DisplayName: 虎魄
		// Tooltip: ""
	}

	DivineFireBeast: {
		DisplayName: 炎兽
		Tooltip:
			'''
			左键攻击有概率点燃敌人
			右键扔出武器，可停在物块(有概率停在平台上)或敌人身上
			此时左键可以收回武器，右键可以传送到武器周围并收回武器
			收回武器后强化一次左键攻击
			'''
	}
}

