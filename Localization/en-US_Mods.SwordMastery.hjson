	TigerVigor: {
		DisplayName: Tiger Vigor
		Tooltip: ""
	}

	DivineFireBeast: {
		DisplayName: Divine Fire Beast
		Tooltip:
			'''
			Left-click attacks have a chance to ignite enemies.
			Right-click throws the weapon, which can stick to blocks (with a chance to stick to platforms) or enemies.
			While the weapon is out, left-click can recall it, and right-click can teleport you near the weapon and recall it.
			After recalling the weapon, your next left-click attack is empowered.
			'''
	}
