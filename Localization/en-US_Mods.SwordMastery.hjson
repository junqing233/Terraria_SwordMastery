			(3 imperial guards for the first sword, 1 sword for the rest / 1 imperial guard)
			+10% Whip Attack Speed
			+10% Movement Speed
			Lasts 2 seconds
			'''
	}

	FlyingExcalibur: {
		DisplayName: Flying Excalibur
		Tooltip:
