Configs: {
	SwordMasteryConfig: {
		DisplayName: Sword Master client configuration

		StrengthExperience: {
			Label: Module strength experience
			Tooltip:
				'''
				Select the overall experience intensity of the module: 'I am God' is a super model experience, and 'Pursue Ordinary' is an ordinary experience.
				(Changes require re-entering the map)
				'''
		}

		EnableExtraAffix: {
			Label: Enable additional supermodel entries
			Tooltip:
				'''
				Turn on to enable the module's special supermodel entry
				Accessories: PrimeCall, DualSoul, TriBond, QuadHost
				'''
		}

		EnableSwordMasteryPrefixes: {
			Label: Enable Sword Master module prefix
			Tooltip:
				'''
				Turn on to enable module special terms
				Weapons: UltimateFinisher, Awaken, SuckBlood, Mastery, BloodFiend, DivineBlessing, Infinity, Titan, InchFlash
				Accessories: Command, Indenture
				'''
		}

		Headers: {
			视觉设置: visual settings
			体验设置: Experience settings
		}

		FriendlyProjectileAlpha: {
			Label: Friendly barrage transparency
			Tooltip: Set the transparency of friendly barrages, 0 is completely transparent, 1 is completely opaque.
		}
	}

	StrengthMode: {
		Tooltip: ""

		God: {
			Label: I am god
			Tooltip:
				'''
				Module sword weapon panel damage remains unchanged
				The damage conversion rates of scabbards, weapon arsenals, and magic bags remain unchanged.
				'''
		}

		Ordinary: {
			Label: pursue the ordinary
			Tooltip:
				'''
				Module sword weapon panel damage reduced by 40%
				The damage conversion rate of scabbards, weapon arsenals, and magic bags is reduced by 40%.
				'''
		}
	}
}

NPCs: {
	Swordsmith: {
		DisplayName: Swordsmith

		TownNPCMood: {
			Content: Enough, little brother.
			NoHome: I've been wandering outside for a long time and want to settle down.
			FarFromHome: I didn't realize it was going a little far.
			LoveSpace: This is a great place for me to practice swordsmanship.
			DislikeCrowded: It's too crowded, I'm afraid I'll disturb others when I forge the sword.
			HateCrowded: It's too crowded, I'm not used to it.
			LikeBiome: The mountains and rivers here are beautiful, and there are good fields and houses, I fell in love with {BiomeName}.
			DislikeBiome: But it reminds me of something sad, I don't like {BiomeName}.
			LoveNPC: I have a good impression of {NPCName}.
			LikeNPC: Well, {NPCName} is a simple person.
			DislikeNPC: Hold back...... {NPCName} will be punished sooner or later.
			HateNPC: I can't help it, get a knife, I'm going to chop {NPCName}!
			LikeNPC_Princess: I don't dislike {NPCName}.
			Princess_LovesNPC: Well, {NPCName} is really good
		}

		Census.SpawnCondition: Conditions unknown
	}
}

