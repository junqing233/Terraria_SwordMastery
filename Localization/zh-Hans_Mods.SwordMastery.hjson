Configs: {
	SwordMasteryConfig: {
		DisplayName: 剑之大师客户端配置

		StrengthExperience: {
			Label: 模组强度体验
			Tooltip:
				'''
				选择模组整体体验强度：'我即神明'为超模体验，'追求平凡'为普通体验
				（更改生效需重进地图）
				'''
		}

		EnableExtraAffix: {
			Label: 启用额外超模词条
			Tooltip:
				'''
				开启以启用模组特殊超模词条
				饰品：初灵、双魂、叁契、肆御
				'''
		}

		EnableSwordMasteryPrefixes: {
			Label: 启用剑之大师模组前缀
			Tooltip:
				'''
				开启以启用模组特殊词条
				武器：王牌、觉醒、嗜血、大师、血煞、神佑、无限、泰坦、寸闪
				饰品：号令、契约
				'''
		}

		Headers: {
			视觉设置: 视觉设置
			体验设置: 体验设置
		}

		FriendlyProjectileAlpha: {
			Label: 友方弹幕透明度
			Tooltip: 设置友方弹幕的透明度，0为完全透明，1为完全不透明。
		}
	}

	StrengthMode: {
		// Tooltip: ""

		God: {
			Label: 我即神明
			Tooltip:
				'''
				模组御剑武器面板伤害不变
				剑鞘、武器库、魔法袋伤害转换率不变
				'''
		}

		Ordinary: {
			Label: 追求平凡
			Tooltip:
				'''
				模组御剑武器面板伤害降低40%
				剑鞘、武器库、魔法袋伤害转换率降低40%
				'''
		}
	}
}

NPCs: {
	Swordsmith: {
		DisplayName: 铸剑师

		TownNPCMood: {
			Content: 足够了，小兄弟。
			NoHome: 在外漂泊的久了，想安定下来。
			FarFromHome: 不知不觉走得有点远了。
			LoveSpace: 此地很适合我用来练剑。
			DislikeCrowded: 周围太拥挤了，我怕铸剑时吵到别人。
			HateCrowded: 这里太拥挤了，我不是很习惯。
			LikeBiome: 这里山青水秀，且有良田屋舍，我爱上了{BiomeName}。
			DislikeBiome: 不过这里让我想起了一些伤心事，我并不喜欢{BiomeName}。
			LoveNPC: 我对{NPCName}颇有好感。
			LikeNPC: 嗯{NPCName}是一个单纯的人。
			DislikeNPC: 忍住……{NPCName}迟早会遭天谴的。
			HateNPC: 忍不住了，拿刀来，我要砍{NPCName}！
			LikeNPC_Princess: 我并不反感 {NPCName}。
			Princess_LovesNPC: 嗯{NPCName}的确很优秀
		}

		// Census.SpawnCondition: Conditions unknown
	}
}

