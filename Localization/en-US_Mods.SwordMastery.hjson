		DisplayName: Flying Zenith
		Tooltip:
			'''
			When "Zenith Sword·Yu" attacks
			Triggers all Mitsurugi's powers
			'''
	}

	DemonSuppressingSword: {
		DisplayName: Demon Suppressing Sword
		Tooltip:
			'''
			When attacking with "Demon Suppressing Sword"
			50% probability of triggering Little Sword Spirit
			Killing the target will restore 20% of the player's health. The more swords summoned, the more health will be restored.
			There is a very low probability of triggering the "kill" effect. The lower the enemy's HP percentage, the greater the probability.
			'''
	}

	SpringSpirit: {
		DisplayName: Spring Spirit
		Tooltip:
			'''
			It has the purest spiritual waves in the world, which can illuminate a person's heart and soul
			A villain shows his timidity, but a gentleman shows his magnanimity, which is called "Zhao Bing"
			(Holy Spirit Environment Blood Moon Fishing)
			'''
	}

